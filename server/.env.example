# Port for Express server
PORT=5000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/pms_db

# Alternatively, discrete DB connection variables:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_NAME=pms_db

# JWT Secret for signing authentication tokens
JWT_SECRET=replace_with_a_secure_random_secret_in_production

